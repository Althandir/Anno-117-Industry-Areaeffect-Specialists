                                    <ObjectFilter>
                                      <UseContextObjects>1</UseContextObjects>
                                    </ObjectFilter>
                                  </Values>
                                </ObjectFilter>
                              </ObjectLocations>
                            </LocationFilter>
                          </Values>
                        </LocationFilter>
                      </ConditionLocationFilter>
                    </Values>
                  </Condition>
                </PreConditionList>
              </Values>
            </BoostCondition>
            <BoostBuffs>
              <Item>
                <GUID>1600000685</GUID>
              </Item>
            </BoostBuffs>
            <BoostHint>1600000426</BoostHint>
          </ItemWithBoost>

        </Values>
